+/**
+ * The foreground process of the terminal: the team of its process group,
+ * named by the program it runs.
+ */
+static char *
+pty_getproc(int fd, char *tty) {
+  pid_t pgrp = tcgetpgrp(fd);
+  if (pgrp == -1) {
+    return NULL;
+  }
+
+  team_info info;
+  if (get_team_info(pgrp, &info) != B_OK) {
+    return NULL;
+  }
+
+  char *program = info.args;
+  char *end = strchr(program, ' ');
+  if (end) {
+    *end = '\0';
+  }
+  char *slash = strrchr(program, '/');
+  return strdup(slash ? slash + 1 : program);
+}
